{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "main.py" },
  { "src": "/processos/(.*)", "dest": "main.py" },
  { "src": "/cache/(.*)", "dest": "main.py" },
  { "src": "/health", "dest": "main.py" },
  { "src": "/(.*)", "dest": "/index.html" }
  ]
}